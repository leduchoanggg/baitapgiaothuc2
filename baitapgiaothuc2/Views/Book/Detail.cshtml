@model StudentManagement.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
}

<div style="padding: 20px; font-family: Arial, sans-serif; max-width: 400px;">
    <h2>THÊM SÁCH MỚI</h2>

    @if (ViewBag.Message != null)
    {
        <div style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; margin-bottom: 15px; border-radius: 4px;">
            @ViewBag.Message
        </div>
    }

    <form action="/Book/Create" method="post">
        <div style="margin-bottom: 15px;">
            <label asp-for="Name">Tên sách:</label><br />
            <input asp-for="Name" style="width: 100%; padding: 8px;" />
            <!-- Hiển thị báo lỗi nếu để trống tên -->
            <span asp-validation-for="Name" style="color: red; font-size: 14px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Price">Giá:</label><br />
            <input asp-for="Price" type="number" step="0.01" style="width: 100%; padding: 8px;" />
            <!-- Hiển thị báo lỗi nếu giá <= 0 -->
            <span asp-validation-for="Price" style="color: red; font-size: 14px;"></span>
        </div>

        <button type="submit" style="padding: 8px 15px; background-color: #007bff; color: white; border: none; cursor: pointer; border-radius: 4px;">Thêm sách</button>
        <a href="/Book/Index" style="margin-left: 10px;">Quay lại danh sách</a>
    </form>
</div>