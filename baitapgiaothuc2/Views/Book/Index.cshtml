@model List<StudentManagement.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<div style="padding: 20px; font-family: Arial, sans-serif;">
    <h2>DANH SÁCH SÁCH</h2>
    <p><a href="/Book/Create" style="padding: 8px 12px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;">+ Thêm sách mới</a></p>

    <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-top: 15px;">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th>ID</th>
                <th>Tên Sách</th>
                <th>Giá ($)</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Name</td>
                    <td>@book.Price</td>
                    <td>
                        <a href="/Book/Detail/@book.Id">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>