@{
    ViewData["Title"] = "Thêm sách mới";
}

<div style="padding: 20px; font-family: Arial, sans-serif; max-width: 400px;">
    <h2>THÊM SÁCH MỚI</h2>

    @if (ViewBag.Message != null)
    {
        <div style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; margin-bottom: 15px; border-radius: 4px;">
            @ViewBag.Message
        </div>
    }

    <form action="/Book/Create" method="post">
        <div style="margin-bottom: 15px;">
            <label>Tên sách:</label><br />
            <input type="text" name="name" style="width: 100%; padding: 8px;" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Giá:</label><br />
            <input type="number" step="0.01" name="price" style="width: 100%; padding: 8px;" required />
        </div>

        <button type="submit" style="padding: 8px 15px; background-color: #007bff; color: white; border: none; cursor: pointer; border-radius: 4px;">Thêm sách</button>
        <a href="/Book/Index" style="margin-left: 10px;">Quay lại danh sách</a>
    </form>
</div>